# Static response hardening. The deploy builder replaces the inline-script
# placeholder with SHA-256 hashes collected from the allowlisted HTML files.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://static.cloudflareinsights.com 'sha256-8O6P8rlbrjyTZ3DQm0OIceLjUg0rAUyKh0jiiJ3QT4Y=' 'sha256-PZzLapxf7BXslGaiIz+o33E3yPYmzUFTJc4Mw7M7zIA=' 'sha256-YFGi/mz/r2ZamOarnidksX2p7zCMPbq5lNt9pHjpRHI=' 'sha256-byq9csLa+kFNuE+Vf6lys67cNBY3yeC0NYqZin8iHnk=' 'sha256-gzzslEv9rgUJMyk0IGOhtbgnl/c7czvMINg1DgLGqmA=' 'sha256-i+3PJBYE/EqdXuStoyq4/I3CTCvUzBWLRm+CdrCnKs4=' 'sha256-q0u2TUEjTGrbokf/kzIJzuxdkd4C5MikHC6wA1krCq4=' 'sha256-tWMf9avEHsvvebDgxz65CdH5/C7fqAGKky0vXqI53uA='; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https://cloudflareinsights.com https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://*.google-analytics.com; frame-src https://coupa.ng https://ads-partners.coupang.com https://partners.coupangcdn.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  X-Permitted-Cross-Domain-Policies: none

# Root and clean-URL HTML routes revalidate on every navigation.
/
  Cache-Control: no-cache, must-revalidate

/:page
  Cache-Control: no-cache, must-revalidate

/giftcard/*
  Cache-Control: no-cache, must-revalidate

# JSON changes frequently; allow a short stale response while it refreshes.
/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=1800

# Asset URLs carry a release query version, but filenames are not content hashes.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
