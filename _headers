# Root and clean-URL HTML routes revalidate on every navigation.
/
  Cache-Control: no-cache, must-revalidate

/:page
  Cache-Control: no-cache, must-revalidate

/giftcard/*
  Cache-Control: no-cache, must-revalidate

# JSON changes frequently; allow a short stale response while it refreshes.
/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=1800

# Asset URLs carry a release query version, but filenames are not content hashes.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
